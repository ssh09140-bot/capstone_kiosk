// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                         Int             @id @default(autoincrement())
  email                      String          @unique
  password                   String
  storeName                  String
  storeId                    String          @unique @default(uuid())
  products                   Product[]
  orders                     Order[]
  categories                 Category[]
  optionGroups               OptionGroup[]
  purchaseOrders             PurchaseOrder[]
  notifications              Notification[]
  inventories                Inventory[]
  suppliers                  Supplier[]
  billingKey                 String?
  customerKey                String?
  cardCompany                String?
  cardNumber                 String?
  businessRegistrationNumber String?         @unique
  businessLicenseImageUrl    String?
  storeAddress               String? // New field for store address
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  store    User      @relation(fields: [storeId], references: [storeId])
  storeId  String
  products Product[]
}

model Product {
  id                    Int                   @id @default(autoincrement())
  name                  String
  description           String?
  price                 Int
  imageUrl              String?
  createdAt             DateTime              @default(now())
  owner                 User                  @relation(fields: [storeId], references: [storeId])
  storeId               String
  category              Category?             @relation(fields: [categoryId], references: [id])
  categoryId            Int?
  optionGroups          OptionGroup[]
  orderItems            OrderItem[]
  purchaseOrderItems    PurchaseOrderItem[]
  inventoryUsages       ProductInventoryUsage[] // 재고 소모량 연결
  // Fields for events
  isEventProduct        Boolean               @default(false)
  eventPrice            Int?
}

model OptionGroup {
  id       Int      @id @default(autoincrement())
  name     String
  store    User     @relation(fields: [storeId], references: [storeId])
  storeId  String
  options  Option[]
  products Product[]
}

model Option {
  id            Int         @id @default(autoincrement())
  name          String
  price         Int
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id])
  optionGroupId Int
}

model Order {
  id            Int            @id @default(autoincrement())
  totalAmount   Int
  totalCost     Float? // 주문 총 원가
  createdAt     DateTime       @default(now())
  store         User           @relation(fields: [storeId], references: [storeId])
  storeId       String
  orderItems    OrderItem[]
  inventoryLogs InventoryLog[] // 재고 변동 로그 연결
  // Fields for recommendation engine
  weather       String? // e.g., "Rain", "Clear"
  temperature   Float? // e.g., 25.5
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  order           Order    @relation(fields: [orderId], references: [id])
  orderId         Int
  product         Product  @relation(fields: [productId], references: [id])
  productId       Int
  quantity        Int
  pricePerItem    Int
  costPerItem     Float? // 주문 시점의 개당 원가
  selectedOptions Json?
}

model PurchaseOrder {
  id                   Int                 @id @default(autoincrement())
  createdAt            DateTime            @default(now())
  orderedAt            DateTime?
  estimatedDeliveryAt  DateTime?
  deliveredAt          DateTime?
  status               PurchaseOrderStatus @default(PENDING_CONFIRMATION)
  store                User                @relation(fields: [storeId], references: [storeId])
  storeId              String
  supplier             Supplier?           @relation(fields: [supplierId], references: [id])
  supplierId           Int?
  purchaseOrderItems   PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id                Int           @id @default(autoincrement())
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId   Int
  product           Product?      @relation(fields: [productId], references: [id])
  productId         Int?
  inventory         Inventory?    @relation(fields: [inventoryId], references: [id])
  inventoryId       Int?
  quantity          Float // Int -> Float
  defectiveQuantity Float?
}

model Notification {
  id        Int              @id @default(autoincrement())
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  type      NotificationType
  store     User             @relation(fields: [storeId], references: [storeId])
  storeId   String
}

model Inventory {
  id                       Int                   @id @default(autoincrement())
  name                     String
  quantity                 Float
  unit                     String // e.g., "kg", "L", "pieces"
  itemType                 String? // New field: e.g., "Coffee Bean", "Milk", "Syrup", "Cup"
  threshold                Float?
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  store                    User                  @relation(fields: [storeId], references: [storeId])
  storeId                  String
  purchaseOrderItems       PurchaseOrderItem[]
  inventoryUsages          ProductInventoryUsage[] // 제품 연결
  logs                     InventoryLog[] // 재고 로그
  // Fields for automated ordering
  autoOrderEnabled         Boolean               @default(false)
  minStockThreshold        Float?
  orderQuantity            Float?
  estimatedDeliveryDays    Int?
  lastLowStockNotifiedAt   DateTime? // 알림 반복 방지
  suppliedBy               SupplierInventory[]

  @@unique([name, storeId])
}

model Supplier {
  id             Int                 @id @default(autoincrement())
  name           String
  contact        String?
  email          String?
  address        String?
  store          User                @relation(fields: [storeId], references: [storeId])
  storeId        String
  purchaseOrders PurchaseOrder[]
  supplies       SupplierInventory[]

  @@unique([name, storeId])
}

model SupplierInventory {
  id          Int       @id @default(autoincrement())
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId  Int
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId Int
  price       Float? // 품목별 단가
  leadTimeDays Int? // 품목별 리드타임

  @@unique([supplierId, inventoryId])
}

model ProductInventoryUsage {
  id          Int       @id @default(autoincrement())
  product     Product   @relation(fields: [productId], references: [id])
  productId   Int
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  inventoryId Int
  usageAmount Float // e.g., 15 for 15g of coffee beans
  usageUnit   String? // e.g., "g", "ml", "pcs"

  @@unique([productId, inventoryId])
}

model InventoryLog {
  id          Int       @id @default(autoincrement())
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  inventoryId Int
  change      Float // Positive for increase, negative for decrease
  reason      String // e.g., "Order #123", "Stock Correction", "PO #45 Received"
  order       Order?    @relation(fields: [orderId], references: [id])
  orderId     Int?
  createdAt   DateTime  @default(now())
}

enum PurchaseOrderStatus {
  PENDING_CONFIRMATION
  ORDERED
  DELIVERED
  CANCELLED
}

enum NotificationType {
  LOW_STOCK_WARNING
  ORDER_CONFIRMATION
  DELIVERY_PROMPT
  DELIVERY_REMINDER
}