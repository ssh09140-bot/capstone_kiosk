// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                             Int     @id @default(autoincrement())
  email                          String  @unique
  password                       String? // 이메일/비밀번호 로그인용
  firebaseUid                    String? @unique // Firebase 인증용
  storeName                      String
  storeId                        String  @unique @default(uuid())

  // 관계형 필드들
  products       Product[]
  orders         Order[]
  categories     Category[]
  optionGroups   OptionGroup[]
  purchaseOrders PurchaseOrder[]
  notifications  Notification[]
  inventories    Inventory[]
  suppliers      Supplier[]

  // 결제/사업자 정보
  billingKey                 String?
  customerKey                String?
  cardCompany                String?
  cardNumber                 String?
  businessRegistrationNumber String? @unique
  businessLicenseImageUrl    String?
  storeAddress               String?
  
  pushSubscriptions          PushSubscription[]
}

model PushSubscription {
  id           Int      @id @default(autoincrement())
  endpoint     String   @unique
  keys         Json
  user         User     @relation(fields: [storeId], references: [storeId])
  storeId      String
  createdAt    DateTime @default(now())
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  store    User      @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  storeId  String
  products Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Int
  stock       Int      @default(0)
  imageUrl    String?
  createdAt   DateTime @default(now())

  owner   User   @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  storeId String

  category   Category? @relation(fields: [categoryId], references: [id])
  categoryId Int?

  optionGroups       OptionGroup[]
  orderItems         OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  inventoryUsages    ProductInventoryUsage[]

  isEventProduct Boolean @default(false)
  eventPrice     Int?

  @@index([storeId, categoryId])
}

model OptionGroup {
  id      Int      @id @default(autoincrement())
  name    String
  store   User     @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  storeId String
  options Option[]
  products Product[]
}

model Option {
  id            Int         @id @default(autoincrement())
  name          String
  price         Int
  optionGroup   OptionGroup @relation(fields: [optionGroupId], references: [id])
  optionGroupId Int
}

model Order {
  id          Int      @id @default(autoincrement())
  totalAmount Int
  totalCost   Float?
  createdAt   DateTime @default(now())

  store   User   @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  storeId String

  orderItems    OrderItem[]
  inventoryLogs InventoryLog[]

  status        OrderStatus    @default(PENDING)

  weather     String?
  temperature Float?

  @@index([storeId, createdAt])
}

model OrderItem {
  id              Int     @id @default(autoincrement())
  order           Order   @relation(fields: [orderId], references: [id])
  orderId         Int
  product         Product @relation(fields: [productId], references: [id])
  productId       Int
  quantity        Int
  pricePerItem    Int
  costPerItem     Float?
  selectedOptions Json?
}

model PurchaseOrder {
  id                  Int                 @id @default(autoincrement())
  createdAt           DateTime            @default(now())
  orderedAt           DateTime?
  estimatedDeliveryAt DateTime?
  deliveredAt         DateTime?
  status              PurchaseOrderStatus @default(PENDING_CONFIRMATION)

  store   User   @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  storeId String

  supplier   Supplier? @relation(fields: [supplierId], references: [id])
  supplierId Int?

  purchaseOrderItems PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              Int           @id @default(autoincrement())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  purchaseOrderId Int

  product   Product? @relation(fields: [productId], references: [id])
  productId Int?

  inventory   Inventory? @relation(fields: [inventoryId], references: [id])
  inventoryId Int?

  quantity          Float
  defectiveQuantity Float?
}

model Notification {
  id        Int              @id @default(autoincrement())
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  type      NotificationType

  store   User   @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  storeId String
}

model Inventory {
  id        Int      @id @default(autoincrement())
  name      String
  quantity  Float
  unit      String
  itemType  String?
  threshold Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store   User   @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  storeId String

  purchaseOrderItems PurchaseOrderItem[]
  inventoryUsages    ProductInventoryUsage[]
  logs               InventoryLog[]
  suppliedBy         SupplierInventory[]

  autoOrderEnabled       Boolean   @default(false)
  minStockThreshold      Float?
  orderQuantity          Float?
  estimatedDeliveryDays  Int?
  packAmount             Float     @default(1.0)
  lastLowStockNotifiedAt DateTime?

  @@unique([name, storeId])
  @@index([storeId])
}

model Supplier {
  id      Int     @id @default(autoincrement())
  name    String
  contact String?
  email   String?
  address String?

  store   User   @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  storeId String

  purchaseOrders PurchaseOrder[]
  supplies       SupplierInventory[]

  @@unique([name, storeId])
}

model SupplierInventory {
  id           Int       @id @default(autoincrement())
  supplier     Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierId   Int
  inventory    Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  inventoryId  Int
  price        Float?
  leadTimeDays Int?
  packAmount   Float     @default(1.0)

  @@unique([supplierId, inventoryId])
}

model ProductInventoryUsage {
  id          Int       @id @default(autoincrement())
  product     Product   @relation(fields: [productId], references: [id])
  productId   Int
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  inventoryId Int
  usageAmount Float
  usageUnit   String?

  @@unique([productId, inventoryId])
}

model InventoryLog {
  id          Int       @id @default(autoincrement())
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  inventoryId Int
  change      Float
  reason      String
  order       Order?    @relation(fields: [orderId], references: [id])
  orderId     Int?
  createdAt   DateTime  @default(now())

  @@index([inventoryId, createdAt])
}

enum OrderStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  PENDING_CONFIRMATION
  ORDERED
  DELIVERED
  CANCELLED
}

enum NotificationType {
  LOW_STOCK_WARNING
  ORDER_CONFIRMATION
  DELIVERY_PROMPT
  DELIVERY_REMINDER
}